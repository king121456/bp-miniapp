ADDR=:8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=bp
JWT_SECRET=change-me-to-a-long-random-string
# 32 字节 AES-256 密钥的十六进制（openssl rand -hex 32）
DATA_KEY=
# APP_ENV=dev 时才允许留空（开发模式：openid=dev_<code>，订阅消息只打印日志）；否则没配会直接启动失败
APP_ENV=
WX_APPID=
WX_SECRET=
WX_TPL_MEASURE=
WX_TPL_MED=
WX_TPL_FAMILY=
# 仅 APP_ENV=dev 生效：允许浏览器 H5 联调的来源，逗号分隔，如 http://127.0.0.1:5173
CORS_ORIGIN=
WX_TPL_VISIT=
# 漏服判定窗口（分钟）、可补记天数、复诊日期最远天数、复诊提醒默认时间
MISS_WINDOW_MINUTES=120
MAKEUP_WINDOW_DAYS=7
VISIT_MAX_DAYS=365
VISIT_REMIND_TIME=19:00
